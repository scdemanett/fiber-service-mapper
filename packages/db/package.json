{
  "name": "@fsm/db",
  "version": "0.0.1",
  "private": true,
  "main": "./src/index.ts",
  "types": "./src/index.ts",
  "exports": {
    ".": "./src/index.ts"
  },
  "scripts": {
    "generate": "npx prisma generate --config prisma.config.ts",
    "db:push": "npx prisma db push --config prisma.config.ts",
    "postdb:push": "node prisma/apply-indexes.mjs",
    "db:migrate": "npx prisma migrate dev --config prisma.config.ts",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@prisma/adapter-pg": "^7.10.0",
    "@prisma/client": "^7.10.0",
    "pg": "^8.23.0"
  },
  "devDependencies": {
    "@types/pg": "^8.23.1",
    "dotenv": "^17.4.2",
    "prisma": "^7.10.0",
    "@typescript/native": "npm:typescript@^7.0.2",
    "typescript": "npm:@typescript/typescript6@^6.0.2"
  }
}
